[device]
; LAN IP address of the eSSL biometric device
ip = 192.168.1.201
; SDK port, 4370 on virtually all eSSL/ZKTeco models
port = 4370
; "Comm Key" / comm password configured on the device (COMM > Ethernet menu). 0 if unset.
comm_password = 0
timeout_seconds = 10

[cloud]
; VODOHRMS base URL, no trailing slash
base_url = http://192.168.1.68:8000
; Plaintext API token shown once when the device was registered in
; Attendance > Biometric Devices > Create (or via "Regenerate Token")
device_token = kQEVZ2NQ5jQHrfrC2FDIqXLyQKSvJ4sOUBbjUgRf
